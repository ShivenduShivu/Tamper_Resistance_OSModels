From b20944c510f036d88b67a07ea7260c9975a62bb9 Mon Sep 17 00:00:00 2001
From: ShivenduShivu <shivendukumarbadal328@gmail.com>
Date: Wed, 11 Nov 2026 02:17:11 +0530
Subject: [PATCH] fix: correct progress-bar labels in vector extraction and the
 scan() docstring

extract_refusal_direction passes the harmful prompts as safe_prompts to flip
the sign of the direction, so the progress bars said "harmless" while it was
reading the harmful prompts (and the other way round). CAA had the same issue
with its positive and negative sets. extract() now takes an optional
keyword-only `labels` argument, and both callers pass the right names. The
default labels are unchanged.

Also fixed the SpectralEntropyMonitor docstring: scan() returns
(prompt_idx, layer_idx, entropy, z_score), not a 3-tuple.
---
 .../core/runtime/inference/vector_extraction.py       | 11 ++++++++---
 .../instrumentation/evaluate/suite/spectral.py        |  2 +-
 src/safetune/interventions/steer/caa.py               |  3 ++-
 src/safetune/interventions/steer/refusal_direction.py |  3 ++-
 4 files changed, 13 insertions(+), 6 deletions(-)

diff --git a/src/safetune/core/runtime/inference/vector_extraction.py b/src/safetune/core/runtime/inference/vector_extraction.py
index 5bcb2a8..a0709d4 100644
--- a/src/safetune/core/runtime/inference/vector_extraction.py
+++ b/src/safetune/core/runtime/inference/vector_extraction.py
@@ -10,7 +10,7 @@ across transformer layers.
 import logging
 import os
 from dataclasses import dataclass, field
-from typing import Any, Dict, List, Optional
+from typing import Any, Dict, List, Optional, Tuple
 
 from tqdm.auto import tqdm
 from safetune._refusal_helpers import _get_decoder_layers
@@ -177,12 +177,17 @@ class SteeringVectorExtractor:
         self,
         safe_prompts: List[str],
         unsafe_prompts: List[str],
+        *,
+        labels: Tuple[str, str] = ("harmless", "harmful"),
     ) -> Dict[int, Any]:
         """Extract steering vectors from contrast datasets.
 
         Args:
             safe_prompts: list of safe/benign prompt strings.
             unsafe_prompts: list of unsafe/harmful prompt strings.
+            labels: names shown in the progress bars for the two prompt sets.
+                Callers that pass other contrast sets (for example harmful
+                prompts as ``safe_prompts`` to flip the sign) can name them here.
 
         Returns:
             dict mapping layer_idx to steering vector (1D tensor).
@@ -197,8 +202,8 @@ class SteeringVectorExtractor:
             len(safe_prompts), len(unsafe_prompts), len(self.config.target_layers),
         )
 
-        safe_acts = self._collect_activations(safe_prompts, desc="harmless")
-        unsafe_acts = self._collect_activations(unsafe_prompts, desc="harmful")
+        safe_acts = self._collect_activations(safe_prompts, desc=labels[0])
+        unsafe_acts = self._collect_activations(unsafe_prompts, desc=labels[1])
 
         vectors: Dict[int, Any] = {}
         for layer_idx in self.config.target_layers:
diff --git a/src/safetune/instrumentation/evaluate/suite/spectral.py b/src/safetune/instrumentation/evaluate/suite/spectral.py
index 60b4b27..e418f6b 100644
--- a/src/safetune/instrumentation/evaluate/suite/spectral.py
+++ b/src/safetune/instrumentation/evaluate/suite/spectral.py
@@ -165,7 +165,7 @@ class SpectralEntropyMonitor:
     1. ``calibrate(benign_prompts)``: build per-layer mean and std of the
        spectral entropy distribution over a corpus of known-safe prompts.
     2. ``scan(prompts)``: run forward over each prompt, compute per-layer
-       entropies, return a list of ``(prompt_idx, layer_idx, z_score)`` for
+       entropies, return a list of ``(prompt_idx, layer_idx, entropy, z_score)`` for
        layers whose entropy drops below ``-z_threshold`` standard deviations
        from the calibrated mean.
     3. ``entropy_trajectory(prompt)``: convenience for analysis. Returns
diff --git a/src/safetune/interventions/steer/caa.py b/src/safetune/interventions/steer/caa.py
index 1fe69bd..40bc7c1 100644
--- a/src/safetune/interventions/steer/caa.py
+++ b/src/safetune/interventions/steer/caa.py
@@ -97,7 +97,8 @@ def extract_caa_vectors(
     ext = SteeringVectorExtractor(model, tokenizer, ve_cfg)
     # Extractor returns ``safe_mean - unsafe_mean``; the CAA convention is
     # ``positive - negative``, so map positive -> safe_prompts.
-    vectors = ext.extract(safe_prompts=positive_prompts, unsafe_prompts=negative_prompts)
+    vectors = ext.extract(safe_prompts=positive_prompts, unsafe_prompts=negative_prompts,
+                          labels=("positive", "negative"))
     logger.info("CAA: extracted %d per-layer behavior vectors.", len(vectors))
     return vectors
 
diff --git a/src/safetune/interventions/steer/refusal_direction.py b/src/safetune/interventions/steer/refusal_direction.py
index 30ccde2..f297f20 100644
--- a/src/safetune/interventions/steer/refusal_direction.py
+++ b/src/safetune/interventions/steer/refusal_direction.py
@@ -272,7 +272,8 @@ def extract_refusal_direction(
                 len(harmful_prompts), len(harmless_prompts), n_val, n_val, 2 * n_val)
     # The extractor's convention is ``safe_mean - unsafe_mean``; flip so the
     # returned direction points *toward* refusal (harmful_mean - harmless_mean).
-    raw = extractor.extract(safe_prompts=fit_harmful, unsafe_prompts=fit_harmless)
+    raw = extractor.extract(safe_prompts=fit_harmful, unsafe_prompts=fit_harmless,
+                            labels=("harmful", "harmless"))
     directions = {k: v for k, v in raw.items()}
 
     def _middle_layer() -> int:
