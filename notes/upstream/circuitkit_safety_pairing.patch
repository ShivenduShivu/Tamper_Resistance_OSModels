--- a/src/circuitkit/tasks/safety_datasets.py
+++ b/src/circuitkit/tasks/safety_datasets.py
@@ -32,7 +32,7 @@ ready-made entry points for the common ones.
 from __future__ import annotations
 
 import logging
-from typing import Optional
